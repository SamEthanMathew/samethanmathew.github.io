{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "framework": null,
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
